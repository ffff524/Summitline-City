# Trage hier die E-Mail-Adresse des Hauptadministrators ein.
OWNER_EMAIL=finnmunzinger61@gmail.com
# Trage hier einen einmaligen, geheimen Startcode ein (mindestens 24 Zeichen).
# Falls das Feld leer bleibt, zeigt die Serverkonsole beim ersten Start einen zufälligen Code an.
OWNER_SETUP_TOKEN=
PORT=3000
HOST=127.0.0.1
# Nach Einrichtung von HTTPS auf true setzen.
SECURE_COOKIES=false
# Wenn du die App hinter einem Reverse Proxy betreibst, muss HTTPS extern eingerichtet werden.
